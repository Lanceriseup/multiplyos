# GoHighLevel (LeadConnector) private integration
# Copy this file to .env.local and fill in the real values (never commit .env.local).

# Private Integration Token — GHL → Settings → Private Integrations.
# Required scopes: contacts.write, contacts.readonly
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account (location) ID — GHL → Settings → Business Info, or the URL after /location/
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Calendar ID — the last path segment of your calendar's booking link.
# Used to fetch free slots and create appointments via the API.
GHL_CALENDAR_ID=XXXXXXXXXXXX

# (Optional) Calendar booking widget link — only used as a fallback redirect.
# Example: https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
GHL_CALENDAR_URL=

# (Optional) Custom field IDs for the extra demo-form questions.
# GHL → Settings → Custom Fields → open the field → copy its ID.
# Leave blank to keep saving these in the contact note instead.
GHL_FIELD_TEAM_SIZE=
GHL_FIELD_DEMO_INTEREST=

# ---- Coaching call ( /coaching-call — "Book a Call to Learn More" ) --------
# Prefilled booking widget link for the COACHING calendar (Mark Simpson setup).
# When set, the coaching form sends the qualified lead straight here after
# capture. Leave blank to show an "our team will reach out" confirmation.
# Example: https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
GHL_COACHING_CALENDAR_URL=

# (Optional) Custom field IDs for the coaching qualifier questions.
# Leave blank to keep saving these in the contact note instead.
GHL_FIELD_BUSINESS_OWNER=
GHL_FIELD_INDUSTRY=
GHL_FIELD_REVENUE=

# ---- Inbound webhook (coaching-call form → HighLevel workflow) ------------
# GHL → Automation → Workflows → new workflow → trigger "Inbound Webhook",
# then copy the generated URL here. Every /coaching-call submission is POSTed
# to it as JSON. Independent of the PIT above, so it works on its own.
# Example: https://services.leadconnectorhq.com/hooks/XXXX/webhook-trigger/XXXX
GHL_INBOUND_WEBHOOK_URL=
